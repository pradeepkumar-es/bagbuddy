<%-include("./partials/header")%>
<!-- for payment -->
<% if(successStatus && successStatus.length>0){ %>
<div
  class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-green-500 flash-message"
>
  <span class="inline-block mt-1 mb-1 text-white">
    <%# flash message is internally stored as an array%> <%= successStatus[0] %>
  </span>
</div>
<% } %>
<div class="py-5 px-40">
    <h1 class="font-bold text-2xl pb-2">Your Orders</h1>
    <hr>
    <%if(ordersData && ordersData.length>0){%>
        <%ordersData.reverse().forEach((item)=>{%>
    <div class="mt-3 mb-3 flex flex-col border border-solid border-zinc-300 rounded-md">
        <div class="bg-zinc-100 h-24 p-5 flex flex-row">
            <div class="w-3/4 flex flex flex-row ">
                <p class="pr-10">ORDER PLACED <br><%=item.createdAt%></p>
                <p>TOTAL <br> ₹<%=item.totalAmount%></p>
            </div>
            <div class="w-1/4">
                order #<%=item._id%>
            </div>
        </div>
        <%item.orders.forEach((productObject)=>{%>
        <div class="h-full p-5 flex flex-row ">
            <div class="w-1/6">
                <img 
                src="data:<%=productObject.product.imageType%>;base64,<%=productObject.product.image.toString('base64')%>"
                class="w-30 h-20"
                 alt="">
            </div>
            <div class="w-3/6 pt-5 text-[<%=productObject.product.textcolor%>] flex flex-col justify-start">
                <p><%=productObject.product.name%></p>
                <p>quantity: <%=productObject.quantity%></p>
            </div>
            <div class="w-2/6 text-right pr-10 pt-3">
                <button class="w-full bg-yellow-500 px-5 py-2 border border-solid rounded-lg ">
                    <a href="/buy/<%=productObject.product._id%>">Buy Again</a></button>
            </div>
        </div>
        <%})%>
    </div>
        <%})%>

        <%}else{%>
            <p>No Orders yet.</p>
            <%}%>
</div>
<script>
  setTimeout(() => {
    const message = document.querySelector(".flash-message");
    if (message) message.remove();
  }, 3000);
</script>
<%-include("./partials/footer")%>