<%- include('./partials/header') %>
<!-- for payment  -->
 <% if(cancel && cancel.length>0){ %>
<div
  class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500 flash-message"
>
  <span class="inline-block mt-1 mb-1 text-white"> <%= cancel[0] %> </span>
</div>
<% } %>
<% if(success.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500 flash-message">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success[0] %>
            </span>
        </div>
        <% } %>
    <% if(error.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500 flash-message">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= error[0] %>
            </span>
        </div>
        <% } %>
    <div class="w-full h-screen flex">
        <!-- product and product price -->
        <div class="w-[70%] h-screen flex flex-col">
            <%if(user.cart.length>0){%>
                <%user.cart.forEach((item)=>{%>
                <%if(item){%>
                                    <div class="w-full h-full flex items-start px-20 py-5 gap-10">
                    <!-- product -->
                    <div class="w-[30%] rounded-md overflow-hidden">
                        <div class="w-full flex justify-center items-center h-80 bg-[<%=item.product.bgcolor%>]">
                            <img class="h-[18rem]"
                                src="data:<%=item.product.imageType %>;base64,<%=item.product.image.toString('base64') %>" alt="">
                        </div>
                    </div>
                    <!-- final Price breakdown -->
                    <div class="w-[70%]">
                        <h3 class="text-xl">
                            <%=item.product.name%>
                        </h3>
                        <div class="px-10 mt-5">
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Total MRP</h4>
                                <h4>₹ <%=item.product.price%>
                                </h4>
                            </div>
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Discount on MRP</h4>
                                <h4>₹ <%=item.product.discount%>
                                </h4>
                            </div>
                        </div>
                        <div class="w-full h-[1px] bg-black mt-10"></div>
                        <div class="flex mt-5">
                            <div class="w-[65%] flex justify-between px-5 py-4 bg-[<%=item.product.panelcolor%>]">
                            <!-- <h3 class="text-2xl">Clinge Bag</h3> -->
                            <div class="flex items-center gap-2">
                                <a href="/minusquantity/<%=item.product._id%>"><i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i></a>
                                <div class="px-2 py-1 rounded-md bg-white text-black"><%=item.quantity%></div>
                               <a href="/addquantity/<%=item.product._id%>"> <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"></i></a>
                            </div>
                        </div>
                        <div class="w-[35%] flex items-center justify-between px-5 py-3 bg-[<%=item.product.textcolor%>]">
                            <h4 class="text-lg">Net Total </h4>
                            <h2 class="text-lg">₹ <%=item.product.price+20-item.product.discount %></h2>
                        </div>
                            <!-- <h3 class="w-1/3 text-xl">Total Amount</h3>
                            <h3 class="font-semibold text-xl text-green-600">₹ <%=item.price+20-item.discount %></h3> -->
                        </div>
                        <form action=""></form>
                    </div>
                </div>
                <%}else{%>
                    <p>No product</p>
                    <%}%>
                <%})%>
            <%}else{%>
                <p>cart is empty</p>
           <% }%>
        </div>

        <!-- Net Total Subtotal -->
        <div class="w-[30%] ml-10">
            <h2 class="text-xl font-bold">Total Price Breakdown</h2>     
            <div class="flex mt-2">
                <h4 class="w-1/3">Total Product Price:</h4>
                <h4>₹<%=totalProductPrice%> </h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Total Discount:</h4>
                <h4>₹<%=totalDiscount%></h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Platform Fee:</h4>
                <h4>₹20</h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Shipping Fee:</h4>
                <h4>FREE</h4>
            </div>
            <div class="flex mt-2">
                <h4 class="w-1/3">Payable Amount :</h4>
                <h4 class="text-green-600 font-semibold text-xl">₹<%=totalProductPrice-totalDiscount+20%></h4>
            </div>
            <!-- <h3 class="text-xl text-green-600 font-semibold">₹</h3> -->
             <!-- <p><%=user.cart.length%></p> -->
             <% if(user.cart.length>0){%>
                <form action="/payment-checkout" method="POST">
                   <button type="submit" class="mt-3 inline-block bg-yellow-400 rounded-md px-3 py-2">Proceed To Buy</button>
                </form> 
            <% }else{%>
                    <button class="mt-3 inline-block bg-yellow-100 rounded-md cursor-not-allowed text-zinc-300 px-3 py-2" disabled>Proceed To Buy</button>
            <%}%>
        </div>
    </div>
    <script>
        let message = document.querySelector(".flash-message");
        setTimeout(()=>{
          if(message) message.remove();
        },3000)
    </script>
    <%- include('./partials/footer') %>