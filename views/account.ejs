<%- include('./partials/header') %>
<% if(success.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500 flash-message">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success[0] %>
            </span>
        </div>
        <% } %>
    <% if(error.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500 flash-message">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= error[0] %>
            </span>
        </div>
        <% } %>
<div class="flex flex-row">
    <div class="w-1/5 h-screen bg-[#f7f7f7] p-5">
        <h1 class="text-2xl font-bold">Account</h1>
        <p class="font-light text-zinc-600">Manage your account info</p>
        <div class="mt-5">
            <p><a href="#profile">Profile</a></p>
            <p><a href="/cart">My Cart</a></p>
            <p><a href="/users/orders">My Orders</a></p>
            <p><a href="#changePassword">Security</a></p>
        </div>
    </div>
    <div class="w-4/5 h-screen bg-[#ffffff] p-5">
        <!-- profile -->
        <div id="profile"> 
            <h3 class="text-xl font-bold mb-3">Profile Details</h3>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4 class="text-lg">Profile</h4>
                </div>
                <div class="w-2/3 border-2 rounded-md p-4">
                    <h2 class="text-lg font-bold ">Update Profile</h2>
                    <form class="mt-2" action="/update-name" method="POST" onclick="">
                        <div class="flex flex-row">
                            <div>
                                <input type="file"><br>
                            <label for="full-name">Full Name</label><br>
                            <input class="border rounded-md  p-1" type="text" value="<%=user.fullName%>" id="full-name">
                        </div>
                        <div>
                            <img class="w-20 h-20 rounded-full"
                         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7U_ef87Q7CQ1Fx_khkPq-y9IfPmBWrMZ6ig&s">
                        </div>
                        </div>
                        <div class="mt-3">
                        <button class="text-blue-500 bg-zinc-100 hover:bg-red-300 border-none p-2 rounded-sm mr-2" >Cancel</button>
                        <button class="text-stone-100 bg-indigo-500 hover:bg-green-500 border-none py-2 px-4 rounded-sm">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4>Email Address</h4>
                </div>
                <div class="w-2/3">
                    <h4>
                        <%=user.email%>
                    </h4>
                </div>
            </div>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4>Phone Numbers</h4>
                </div>
                <div class="w-2/3">
                    <h4 class="text-blue-800">
                        + Add Phone Number
                    </h4>
                </div>
            </div>
        </div>

        <!-- Cart -->
        <!-- redirect to car page -->

        <!-- Orders: retrive data from stripe payment and database -->
         <!-- password update -->
          <div id="changePassword" class="mt-10"> 
            <h1 class="font-bold text-xl mb-3">Change Password</h1>
                <hr>
            <form action="/users/update-password" method="POST" class="mx-40 my-10">
                <input required class="border rounded-sm border-grey-600 p-1" type="password" name="oldPassword" placeholder="old Password">
                <input required class="border rounded-sm border-grey-600 p-1" type="password" name="newPassword" placeholder="new Password">
                <input required class="border rounded-sm border-grey-600 p-1" type="password" name="confirmPassword" placeholder="confirm Password">
                <input required type="submit" class="bg-yellow-500 px-5 py-1 border border-none rounded-md cursor-pointer">
            </form>
          </div>
    </div>
</div>
<script>
    let message = document.querySelector(".flash-message");
    setTimeout(()=>{
        if(message) message.remove();
    },3000)
</script>
<%- include('./partials/footer') %>