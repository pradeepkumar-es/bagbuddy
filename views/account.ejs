<%- include('./partials/header') %>
<div class="flex flex-row">
    <div class="w-1/5 h-screen bg-[#f7f7f7] p-5">
        <h1 class="text-2xl font-bold">Account</h1>
        <p class="font-light text-zinc-600">Manage your account info</p>
        <div class="mt-5">
            <p>Profile</p>
            <p><a href="/cart">My Cart</a></p>
            <p><a href="/users/orders">My Orders</a></p>
            <p>Security</p>
        </div>
    </div>
    <div class="w-4/5 h-screen bg-[#ffffff] p-5">
        <!-- profile -->
        <div>
            <h3 class="text-xl font-bold mb-3">Profile Details</h3>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4 class="text-lg">Profile</h4>
                </div>
                <div class="w-2/3 border-2 rounded-md p-4">
                    <h2 class="text-lg font-bold ">Update Profile</h2>
                    <form class="mt-2" action="/update-name" method="POST" onclick="">
                        <div class="flex flex-row">
                            <div>
                                <input type="file"><br>
                            <label for="full-name">Full Name</label><br>
                            <input class="border rounded-md  p-1" type="text" value="<%=user.fullName%>" id="full-name">
                        </div>
                        <div>
                            <img class="w-20 h-20 rounded-full"
                         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT7U_ef87Q7CQ1Fx_khkPq-y9IfPmBWrMZ6ig&s">
                        </div>
                        </div>
                        <div class="mt-3">
                        <button class="text-blue-500 bg-zinc-100 hover:bg-red-300 border-none p-2 rounded-sm mr-2" >Cancel</button>
                        <button class="text-stone-100 bg-indigo-500 hover:bg-green-500 border-none py-2 px-4 rounded-sm">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4>Email Address</h4>
                </div>
                <div class="w-2/3">
                    <h4>
                        <%=user.email%>
                    </h4>
                </div>
            </div>
            <hr>
            <div class="flex flex-row mt-3 mb-3">
                <div class="w-1/3">
                    <h4>Phone Numbers</h4>
                </div>
                <div class="w-2/3">
                    <h4 class="text-blue-800">
                        + Add Phone Number
                    </h4>
                </div>
            </div>
        </div>

        <!-- Cart -->
        <!-- redirect to car page -->

        <!-- Orders: retrive data from stripe payment and database -->
    </div>
</div>
<%- include('./partials/footer') %>