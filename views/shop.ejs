<%- include('./partials/header') %> <% if(success.length>0){ %>
<div
  class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500 flash-message"
>
  <span class="inline-block mt-1 mb-1 text-white"> <%= success[0] %> </span>
</div>
<% } %>
<div class="w-full h-screen flex items-start px-20 py-20">
  <div class="w-[25%] flex h-screen flex-col items-start">
    <div class="flex items-center gap-2">
      <h3>sort by</h3>
      <form action="/" method="GET">
        <select class="border-[1px] px-2 py-1" name="filter" id="" onchange="this.form.submit()">
          <option value="popular">Popular</option>
          <option value="newest">Newest</option>
          <option value="discounted">Discounted</option>
        </select>
      </form>
    </div>
    <div class="flex flex-col mt-20">
      <a class="block w-fit mb-2" href="">Filter by :</a>
      <a class="block w-fit mb-2" href="/">All Products</a>
      <a class="block w-fit mb-2" href="/discounted-products"
        >Discounted Products</a
      >
    </div>
  </div>
  <div class="w-[75%] flex flex-col gap-5 h-screen">
    <div class="flex items-start gap-5">
      <% let items = typeof productsByDiscount !== "undefined" ?
      productsByDiscount : products; %> <% if (items && items.length > 0) { %>
      <% items.forEach(function(product) { %>
      <!-- product card -->
      <div class="w-60">
        <div
          class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]"
        >
          <img
            class="h-[12rem]"
            src="data:<%= product.imageType %>;base64,<%= product.image.toString('base64') %>"
            alt=""
          />
        </div>
        <div
          class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-4 text-[<%= product.textcolor %>]"
        >
          <div>
            <h3><%= product.name %></h3>
            <% if (product.discount > 0) { %>
            <h5><del>M.R.P.: ₹<%= product.price %></del></h5>
            <h4>₹ <%= product.price - product.discount %></h4>
            <% } else { %>
            <h5>M.R.P.: ₹<%= product.price %></h5>
            <% } %>
          </div>
          <a
            class="w-7 h-7 flex items-center justify-center rounded-full bg-white"
            href="/addtocart/<%= product._id %>"
          >
            <i class="ri-add-line"></i>
          </a>
        </div>
      </div>
      <% }) %> <% } else { %>
      <p>No products found.</p>
      <% } %>
    </div>
  </div>
</div>
<script>
  setTimeout(() => {
    const message = document.querySelector(".flash-message");
    if (message) message.remove();
  }, 3000);
</script>
<%- include('./partials/footer') %>
